# ─── Kopyalayın: cp .env.example .env ───────────────────────────────────────
# .env dosyası git'e commit edilmez.

# ─── LLM sağlayıcı (opsiyonel kolaylık) ─────────────────────────────────────
# LLM sağlayıcılar normalde ARAYÜZDEN tanımlanır (Ayarlar → LLM sağlayıcılar).
# OpenRouter, LiteLLM proxy veya OpenAI-uyumlu herhangi bir servis eklenebilir
# ve birden fazlası aynı anda tanımlı olabilir.
#
# Buradaki anahtar yalnızca bir kolaylık: hiç sağlayıcı tanımlı değilken sunucu
# açılırsa, bu değerden otomatik bir OpenRouter sağlayıcısı oluşturulur.
# Sağlayıcıyı arayüzden silip yeniden başlatırsanız geri gelir — istemiyorsanız
# bu satırı boş bırakın.
# Anahtar: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=agentcoder
POSTGRES_PASSWORD=agentcoder_dev_parola_degistirin
POSTGRES_DB=agentcoder
# Host'a açılan port. Container içi port her zaman 5432'dir; bu değer yalnızca
# dışarıdan psql ile bağlanmak içindir. Makinedeki diğer projelerle çakışmasın
# diye varsayılan 5432 değil.
POSTGRES_PORT=5434
# Backend container içinden erişim (compose servis adı 'postgres')
DATABASE_URL=postgres://agentcoder:agentcoder_dev_parola_degistirin@postgres:5432/agentcoder?sslmode=disable

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
LOG_LEVEL=info
# 32 baytlık base64 anahtar — credential'ları AES-GCM ile şifreler.
# Üretin: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=DEGISTIRIN_openssl_rand_base64_32_ile_uretin=

# ─── Frontend ───────────────────────────────────────────────────────────────
# Host'a açılan port; container içi port her zaman 3000'dir.
FRONTEND_PORT=3002
# Tarayıcıdan erişilen adres (container adı değil, host adresi)
NEXT_PUBLIC_API_URL=http://localhost:8080

# ─── Runner sandbox ─────────────────────────────────────────────────────────
# Burada YALNIZCA dağıtım topolojisi durur. Süre sınırı, eşzamanlılık, CPU ve
# bellek gibi davranış parametreleri arayüzden yönetilir (Ayarlar → Çalıştırma)
# ve veritabanında tutulur; buraya yazılan bir değer etkisiz kalırdı.
RUNNER_IMAGE=agent-coder/opencode-runner:latest
RUNNER_NETWORK=agent-coder_internal
# opencode server'ın basic auth parolası (backend ile runner arasında)
OPENCODE_SERVER_PASSWORD=degistirin_rastgele_parola

# ─── Git erişimi ────────────────────────────────────────────────────────────
# Git erişimleri arayüzden tanımlanır (Ayarlar → Git erişimleri):
# GitHub (token), Bitbucket (kullanıcı adı + app password) veya genel Git.
# Burada ortam değişkeni tutulmaz.

# ─── Jira ───────────────────────────────────────────────────────────────────
# Jira erişimi arayüzden tanımlanır (Ayarlar → Jira): site adresi, e-posta ve
# API token. Değer veritabanında ŞİFRELİ saklanır.
#
# Burada ortam değişkeni tutulmaz: bir zamanlar JIRA_BASE_URL / JIRA_EMAIL /
# JIRA_API_TOKEN vardı ve hiçbir yerde okunmuyordu — okunmayan bir değişkene
# gerçek bir token yazmak, hem yanlış bir güven duygusu hem de gereksiz bir
# sızıntı yüzeyidir.
#
# Tarama aralığı da burada değil: Ayarlar → Jira tetikleyici.
