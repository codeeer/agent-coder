# ─── Kopyalayın: cp .env.example .env ───────────────────────────────────────
# .env dosyası git'e commit edilmez.

# ─── LLM sağlayıcı (opsiyonel kolaylık) ─────────────────────────────────────
# LLM sağlayıcılar normalde ARAYÜZDEN tanımlanır (Ayarlar → LLM sağlayıcılar).
# OpenRouter, LiteLLM proxy veya OpenAI-uyumlu herhangi bir servis eklenebilir
# ve birden fazlası aynı anda tanımlı olabilir.
#
# Buradaki anahtar yalnızca bir kolaylık: hiç sağlayıcı tanımlı değilken sunucu
# açılırsa, bu değerden otomatik bir OpenRouter sağlayıcısı oluşturulur.
# Sağlayıcıyı arayüzden silip yeniden başlatırsanız geri gelir — istemiyorsanız
# bu satırı boş bırakın.
# Anahtar: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_USER=agentcoder
POSTGRES_PASSWORD=agentcoder_dev_parola_degistirin
POSTGRES_DB=agentcoder
# Host'a açılan port. Container içi port her zaman 5432'dir; bu değer yalnızca
# dışarıdan psql ile bağlanmak içindir. Makinedeki diğer projelerle çakışmasın
# diye varsayılan 5432 değil.
POSTGRES_PORT=5434
# Backend container içinden erişim (compose servis adı 'postgres')
DATABASE_URL=postgres://agentcoder:agentcoder_dev_parola_degistirin@postgres:5432/agentcoder?sslmode=disable

# ─── Backend ────────────────────────────────────────────────────────────────
BACKEND_PORT=8080
LOG_LEVEL=info
# 32 baytlık base64 anahtar — credential'ları AES-GCM ile şifreler.
# Üretin: openssl rand -base64 32
SECRET_ENCRYPTION_KEY=DEGISTIRIN_openssl_rand_base64_32_ile_uretin=

# ─── Frontend ───────────────────────────────────────────────────────────────
# Host'a açılan port; container içi port her zaman 3000'dir.
FRONTEND_PORT=3002

# Arayüzde görünen ürün adı: sol üstteki kelime markası ve tarayıcı sekmesi.
# Boş bırakılırsa "Agent Coder" yazar.
#
# Adres gibi bu da imaja GÖMÜLMEZ — aynı hazır imaj her markayla çalışır ve
# değiştirdiğinizde `make restart` yeter. Kenar çubuğuna ~20 karakter sığar;
# uzun adlar üç noktayla kırpılır (tamamı üzerine gelince görünür).
# APP_NAME=Şirket AI

# ─── Erişim adresi ──────────────────────────────────────────────────────────
# Tarayıcının bu kurulumu açtığı makine adı ya da IP.
#
# Kendi bilgisayarınızda çalıştırıyorsanız DOKUNMAYIN.
#
# Bir sunucuya kurup BAŞKA bir makineden açacaksanız burayı sunucunun adresine
# yazın (ör. 192.168.1.40 veya agent.sirket.local). Sebebi: tarayıcı backend'e
# DOĞRUDAN bağlanır; `localhost` kalırsa KENDİ bilgisayarına bağlanmaya çalışır
# ve ekran "sunucuya ulaşılamıyor" der.
#
# Hem arayüzün API adresini hem sunucunun CORS ayarını birlikte düzeltir.
# Değiştirdikten sonra `make restart` yeter.
PUBLIC_HOST=localhost

# Ters vekil (nginx/Traefik) arkasındaysanız yukarısı yetmez; iki adresi de
# tümüyle yazın. Boş bırakılırsa PUBLIC_HOST ve portlardan üretilirler.
# NEXT_PUBLIC_API_URL=https://api.sirket.com
# CORS_ORIGINS=https://agent.sirket.com
#
# NOT: bu adres arayüz imajına GÖMÜLMEZ. Sunucu her istekte ortamdan okuyup
# sayfaya yazar; bu yüzden aynı hazır imaj her kuruluma uyar. Değiştirdiğinizde
# `make restart` yeter, yeniden derleme gerekmez.

# Kurumsal paket deposu (Nexus) BURADA DEĞİL: adres, kullanıcı adı ve token
# arayüzden yönetilir (Ayarlar → Paket deposu) ve veritabanında tutulur.
# Buraya yazılan bir değer etkisiz kalırdı.

# ─── Runner sandbox ─────────────────────────────────────────────────────────
# Burada YALNIZCA dağıtım topolojisi durur. Süre sınırı, eşzamanlılık, CPU ve
# bellek gibi davranış parametreleri arayüzden yönetilir (Ayarlar → Çalıştırma)
# ve veritabanında tutulur; buraya yazılan bir değer etkisiz kalırdı.
RUNNER_IMAGE=agent-coder/opencode-runner:latest
RUNNER_NETWORK=agent-coder_internal
# opencode server'ın basic auth parolası (backend ile runner arasında)
OPENCODE_SERVER_PASSWORD=degistirin_rastgele_parola

# Kurumsal kök sertifika — YEDEK yol.
#
# ASIL YOL ARAYÜZ: Ayarlar → Kurumsal ağ. Orada dosya seçebilir veya içeriği
# yapıştırabilirsiniz; yeniden başlatma gerekmez ve PEM/DER/PKCS#7 biçimlerinin
# üçü de kabul edilir.
#
# Bu değişken, arayüz gelmeden önce kurulmuş sistemler bozulmasın diye duruyor.
# Host üzerindeki bir sertifika dosyasının MUTLAK yolu; backend açılışta okur
# ve içeriğini her runner container'ına kopyalar. Ayar doluysa O kazanır.
#
# TLS doğrulamasını kapatan bir ayar YOKTUR ve eklenmeyecektir: kurumsal ağın
# çözümü kök sertifikayı tanıtmaktır. Ayrıntı: README → "SSL inspection yapan
# kurumsal ağlar".
# RUNNER_EXTRA_CA_CERT=/etc/pki/ca-trust/source/anchors/kurum-kok.pem

# ─── Denetim vekili (varsayılan: kapalı) ────────────────────────────────────
# Runner'ın çıkış trafiğini bir vekilden geçirir: sandbox'ın dışarıya ne
# gönderdiğini okumak için. Doluysa container'a HTTP_PROXY ailesi,
# NODE_USE_ENV_PROXY ve Maven'ın -D vekil özellikleri geçilir.
#
# AÇIKKEN runner'ın TÜM dış trafiği o vekile gider; vekil TLS'i açabiliyorsa
# sağlayıcı anahtarı dahil her şeyi görür. Açılışta uyarı loglanır.
#
# Vekil trafiği YÖNLENDİRİR, MECBUR ETMEZ — vekili yok sayan bir istemci
# (ölçüldü: Maven'ın JVM tarafı) doğrudan çıkabilir. "Tüm çıkış denetleniyor"
# garantisi değildir. Ölçüm yöntemi ve bulgular:
# docs/veri-sizintisi-analizi.md
# RUNNER_HTTP_PROXY=http://vekil:8080

# ─── Git erişimi ────────────────────────────────────────────────────────────
# Git erişimleri arayüzden tanımlanır (Ayarlar → Git erişimleri):
# GitHub (token), Bitbucket (kullanıcı adı + app password) veya genel Git.
# Burada ortam değişkeni tutulmaz.

# ─── Jira ───────────────────────────────────────────────────────────────────
# Jira erişimi arayüzden tanımlanır (Ayarlar → Jira): site adresi, e-posta ve
# API token. Değer veritabanında ŞİFRELİ saklanır.
#
# Burada ortam değişkeni tutulmaz: bir zamanlar JIRA_BASE_URL / JIRA_EMAIL /
# JIRA_API_TOKEN vardı ve hiçbir yerde okunmuyordu — okunmayan bir değişkene
# gerçek bir token yazmak, hem yanlış bir güven duygusu hem de gereksiz bir
# sızıntı yüzeyidir.
#
# Tarama aralığı da burada değil: Ayarlar → Jira tetikleyici.
